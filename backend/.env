# Environment configuration for AI Receptionist Backend

# Check utils/config.py for all available settings

# Application
APP_NAME="AI Receptionist"
ENVIRONMENT="development"
DEBUG=true
API_V1_PREFIX="/api/v1"

# Database
MONGO_URI="mongodb://localhost:27017/ai_barber_receptionist"
MONGO_DB_NAME="ai_barber_receptionist"

# Security
SECRET_KEY="development_secret_key_change_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Vapi Configuration (White-label)
VAPI_PRIVATE_API_KEY=cf632e89-c397-4d3d-9df5-95b564e2951f
VAPI_PUBLIC_KEY=1f432dbe-7cab-496e-93e3-a348408f6726
