# Environment configuration for AI Receptionist Backend

# Check utils/config.py for all available settings

# Application
APP_NAME="AI Receptionist"
ENVIRONMENT="development"
DEBUG=true
API_V1_PREFIX="/api/v1"

# Database
MONGO_URI="mongodb://localhost:27017/calleem"
MONGO_DB_NAME="calleem"

# Security
SECRET_KEY="development_secret_key_change_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Vapi Configuration (White-label)
VAPI_PRIVATE_API_KEY=957f3d01-6229-4834-bfff-667ccf49ff50
VAPI_PUBLIC_KEY=5c43aa1c-9745-47a3-9d71-0e751df8097a
VAPI_WEBHOOK_SECRET=mysecret_webhook
VAPI_WEBHOOK_URL=https://nonsustainable-delaine-grabbable.ngrok-free.dev/api/v1/vapi/webhook
VAPI_ORGANIZATION_ID=af807986-97fe-446d-a4f1-00950d5cd83b
# TODO: Update VAPI_WEBHOOK_SECRET to the new account's webhook secret from Vapi dashboard
VAPI_ALLOW_UNSIGNED_WEBHOOKS=true

# Dashboard
ALLOW_SELF_REGISTRATION=true
MAX_DASHBOARD_USERS=10

# CORS
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,https://aireceptionist-lake.vercel.app"

# Encryption
MASTER_KEY=73024f5bee2803fb907816b5f716773e139569b8be7d5930a5717ca9fcdcb78d
